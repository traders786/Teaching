{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/leads/send-otp",
      "dest": "/api/leads/send-otp.ts"
    },
    {
      "src": "/api/leads/verify-otp",
      "dest": "/api/leads/verify-otp.ts"
    },
    {
      "src": "/api/leads/book-slot",
      "dest": "/api/leads/book-slot.ts"
    },
    {
      "src": "/api/leads/my-demo",
      "dest": "/api/leads/my-demo.ts"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
